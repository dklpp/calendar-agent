# Secrets and machine paths. Copy to .env -- never commit the real file.

ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-opus-5

TELEGRAM_BOT_TOKEN=123456:ABC...
# REQUIRED. An empty whitelist denies everyone, by design: without it anyone
# who finds the bot username could read and rewrite your calendar.
# Send /start to the bot and it will tell you your chat id.
TELEGRAM_ALLOWED_CHAT_IDS=111111111

GOOGLE_CREDENTIALS_PATH=credentials.json
GOOGLE_TOKEN_PATH=token.json

# Built from https://github.com/ggml-org/whisper.cpp
WHISPER_CLI=whisper-cli
WHISPER_MODEL_PATH=models/ggml-small.bin

HOST=0.0.0.0
PORT=8000
